@@ -0,0 +1,54 @@
+#include <gtest/gtest.h>
+#include "input_interface/reference_lease.hpp"
+
+using namespace std::chrono_literals;
+static const ReferenceLease::Clock::time_point origin{};
+
+TEST(ReferenceLease, RequiresArmAndNonnegativeIndex) {
+    ReferenceLease lease(200ms);
+    EXPECT_FALSE(lease.Accept(1, origin));
+    lease.Arm(origin);
+    EXPECT_FALSE(lease.Accept(-1, origin));
+    EXPECT_TRUE(lease.Accept(0, origin));
+    EXPECT_EQ(lease.Index(), 0);
+}
+TEST(ReferenceLease, ExpiresWithoutFirstFrameAtDeadline) {
+    ReferenceLease lease(200ms);
+    lease.Arm(origin);
+    EXPECT_FALSE(lease.Poll(origin + 199ms));
+    EXPECT_TRUE(lease.Poll(origin + 200ms));
+    EXPECT_FALSE(lease.Armed());
+    EXPECT_TRUE(lease.Expired());
+}
+TEST(ReferenceLease, DuplicateAndOlderFramesDoNotExtendDeadline) {
+    ReferenceLease lease(200ms);
+    lease.Arm(origin);
+    ASSERT_TRUE(lease.Accept(100, origin + 10ms));
+    EXPECT_FALSE(lease.Accept(100, origin + 100ms));
+    EXPECT_FALSE(lease.Accept(99, origin + 150ms));
+    EXPECT_EQ(lease.Index(), 100);
+    EXPECT_TRUE(lease.Poll(origin + 210ms));
+}
+TEST(ReferenceLease, NewFrameCannotReviveExpiredLeaseWithoutPolling) {
+    ReferenceLease lease(200ms);
+    lease.Arm(origin);
+    ASSERT_TRUE(lease.Accept(100, origin));
+    EXPECT_FALSE(lease.Accept(101, origin + 200ms));
+    EXPECT_FALSE(lease.Accept(102, origin + 201ms));
+    EXPECT_EQ(lease.Index(), 100);
+    EXPECT_TRUE(lease.Expired());
+}
+TEST(ReferenceLease, IncreasingFramesExtendDeadlineAndRearmPreservesHighWater) {
+    ReferenceLease lease(200ms);
+    lease.Arm(origin);
+    ASSERT_TRUE(lease.Accept(100, origin + 100ms));
+    ASSERT_TRUE(lease.Accept(101, origin + 250ms));
+    EXPECT_FALSE(lease.Poll(origin + 449ms));
+    EXPECT_TRUE(lease.Poll(origin + 450ms));
+    lease.Arm(origin + 500ms);
+    EXPECT_FALSE(lease.Accept(0, origin + 501ms));
+    EXPECT_FALSE(lease.Accept(101, origin + 502ms));
+    EXPECT_TRUE(lease.Accept(102, origin + 503ms));
+    lease.Disarm();
+    EXPECT_FALSE(lease.Accept(103, origin + 504ms));
+}

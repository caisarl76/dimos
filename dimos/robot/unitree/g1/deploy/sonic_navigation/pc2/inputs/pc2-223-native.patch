+#pragma once
+#include <chrono>
+#include <cstdint>
+
+// Caller serializes access; times are receiver steady-clock times.
+class ReferenceLease {
+public:
+    using Clock = std::chrono::steady_clock;
+    explicit ReferenceLease(std::chrono::milliseconds timeout) : timeout_(timeout) {}
+    void Arm(Clock::time_point now) { armed_ = true; expired_ = false; last_ = now; }
+    void Disarm() { armed_ = false; }
+    bool Poll(Clock::time_point now) {
+        if (armed_ && now - last_ >= timeout_) {
+            armed_ = false;
+            expired_ = true;
+        }
+        return expired_;
+    }
+    bool Accept(int64_t index, Clock::time_point now) {
+        if (Poll(now) || !armed_ || index < 0 || index <= index_) return false;
+        index_ = index;
+        last_ = now;
+        return true;
+    }
+    bool Armed() const { return armed_; }
+    bool Expired() const { return expired_; }
+    int64_t Index() const { return index_; }
+    double AgeMs(Clock::time_point now) const {
+        return std::chrono::duration<double, std::milli>(now - last_).count();
+    }
+private:
+    std::chrono::milliseconds timeout_;
+    Clock::time_point last_{};
+    bool armed_ = false, expired_ = false;
+    int64_t index_ = -1;
+};
+
+// A receiver snapshot; planner_confirmed is filled by the successful policy tick.
+struct ReferenceGuardStatus {
+    bool armed = false, expired = false, planner_selected = false, planner_confirmed = false;
+    bool rearm_requires_planner = false;
+    int64_t accepted_index = -1, applied_index = -1;
+    uint64_t rejected = 0, epoch = 0;
+    double age_ms = -1;
+};

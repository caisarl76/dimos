@@ -0,0 +1,73 @@
+#include <gtest/gtest.h>
+#include "input_interface/reference_validation.hpp"
+#include <array>
+#include <limits>
+
+using Subscriber = ZMQPackedMessageSubscriber;
+struct Frame {
+    Subscriber::DecodedHeader header{4, "le", 1, {
+        {"token_state", "f32", {1,64}}, {"frame_index", "i64", {1}},
+        {"left_hand_joints", "f32", {1,7}}, {"right_hand_joints", "f32", {1,7}}}};
+    std::array<float,64> token{};
+    int64_t index = 123;
+    std::array<float,7> left{}, right{};
+    std::vector<Subscriber::BufferView> buffers{{token.data(), sizeof(token)},
+        {&index, sizeof(index)}, {left.data(), sizeof(left)}, {right.data(), sizeof(right)}};
+};
+TEST(ReferenceValidation, ValidatesWholeFrameBeforeReturningIndex) {
+    Frame f;
+    ASSERT_EQ(ValidateGuardReference(f.header, f.buffers), 123);
+    f.right[6] = std::numeric_limits<float>::infinity();
+    EXPECT_FALSE(ValidateGuardReference(f.header, f.buffers));
+    f.right[6] = 0;
+    f.token[0] = std::numeric_limits<float>::quiet_NaN();
+    EXPECT_FALSE(ValidateGuardReference(f.header, f.buffers));
+}
+TEST(ReferenceValidation, RejectsWrongLayoutAndTruncatedPayload) {
+    Frame f;
+    f.header.fields[0].shape = {64};
+    EXPECT_FALSE(ValidateGuardReference(f.header, f.buffers));
+    f.header.fields[0].shape = {1,64};
+    f.buffers[2].size -= 1;
+    EXPECT_FALSE(ValidateGuardReference(f.header, f.buffers));
+    f.buffers[2].size += 1;
+    f.header.fields[2].name = "right_hand_joints";
+    EXPECT_FALSE(ValidateGuardReference(f.header, f.buffers));
+}
+TEST(ReferenceValidation, RejectsUnsupportedVersionsDtypesEndianAndNegativeIndex) {
+    Frame f;
+    f.header.version = 3;
+    EXPECT_FALSE(ValidateGuardReference(f.header, f.buffers));
+    f.header.version = 4;
+    f.header.fields[0].dtype = "f64";
+    EXPECT_FALSE(ValidateGuardReference(f.header, f.buffers));
+    f.header.fields[0].dtype = "f32";
+    f.header.endian = "invalid";
+    EXPECT_FALSE(ValidateGuardReference(f.header, f.buffers));
+    f.header.endian = "le";
+    f.index = -1;
+    EXPECT_FALSE(ValidateGuardReference(f.header, f.buffers));
+}
+TEST(ReferenceValidation, DecodesBigEndianIndexAndFloatValidation) {
+    Frame f;
+    f.header.endian = "be";
+    f.index = byte_swap(int64_t{456});
+    ASSERT_EQ(ValidateGuardReference(f.header, f.buffers), 456);
+    uint32_t inf = byte_swap(uint32_t{0x7f800000});
+    std::memcpy(f.left.data(), &inf, 4);
+    EXPECT_FALSE(ValidateGuardReference(f.header, f.buffers));
+}
+TEST(ReferenceValidation, CommandRequiresThreeBooleanScalars) {
+    Subscriber::DecodedHeader h{1,"le",1,{{"start","u8",{1}},
+        {"stop","u8",{1}}, {"planner","u8",{1}}}};
+    std::array<uint8_t,3> v{0,0,1};
+    std::vector<Subscriber::BufferView> b{{&v[0],1},{&v[1],1},{&v[2],1}};
+    EXPECT_TRUE(ValidateGuardCommand(h,b));
+    v[2] = 2;
+    EXPECT_FALSE(ValidateGuardCommand(h,b));
+    v = {1,1,1};
+    EXPECT_FALSE(ValidateGuardCommand(h,b));
+    v = {0,0,1};
+    b[2].size = 0;
+    EXPECT_FALSE(ValidateGuardCommand(h,b));
+}

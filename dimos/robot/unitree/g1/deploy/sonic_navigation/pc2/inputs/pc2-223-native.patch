+#pragma once
+#include "zmq_packed_message_subscriber.hpp"
+#include <optional>
+#include <set>
+
+// Deliberately narrow opt-in contract: the DimOS single-frame v4 f32 encoder.
+// Validate every field before the caller updates lease, sequence or motor data.
+inline std::optional<int64_t> ValidateGuardReference(
+    const ZMQPackedMessageSubscriber::DecodedHeader& header,
+    const std::vector<ZMQPackedMessageSubscriber::BufferView>& buffers) {
+    if (header.version != 4 || header.count != 1 || header.fields.size() != 4 ||
+        buffers.size() != 4 || (header.endian != "le" && header.endian != "be")) return {};
+    std::set<std::string> seen;
+    int64_t index = -1;
+    for (size_t i = 0; i < 4; ++i) {
+        const auto& field = header.fields[i];
+        const auto& buffer = buffers[i];
+        if (!buffer.data || !seen.insert(field.name).second) return {};
+        if (field.name == "frame_index") {
+            if (field.dtype != "i64" || field.shape != std::vector<size_t>{1} || buffer.size != 8) return {};
+            std::memcpy(&index, buffer.data, 8);
+            if (header.NeedsByteSwap()) index = byte_swap(index);
+            if (index < 0) return {};
+        } else {
+            size_t length = field.name == "token_state" ? 64 :
+                (field.name == "left_hand_joints" || field.name == "right_hand_joints" ? 7 : 0);
+            if (!length || field.dtype != "f32" || field.shape != std::vector<size_t>{1,length} ||
+                buffer.size != length * 4) return {};
+            for (size_t j = 0; j < length; ++j) {
+                // Integer IEEE-754 check remains valid under the deploy build's -ffast-math.
+                uint32_t bits;
+                std::memcpy(&bits, static_cast<const uint8_t*>(buffer.data) + j * 4, 4);
+                if (header.NeedsByteSwap()) bits = byte_swap(bits);
+                if ((bits & 0x7f800000u) == 0x7f800000u) return {};
+            }
+        }
+    }
+    if (index < 0) return {};
+    return index;
+}
+inline bool ValidateGuardCommand(
+    const ZMQPackedMessageSubscriber::DecodedHeader& header,
+    const std::vector<ZMQPackedMessageSubscriber::BufferView>& buffers) {
+    if (header.version != 1 || header.count != 1 || header.fields.size() != 3 || buffers.size() != 3) return false;
+    std::set<std::string> seen;
+    bool start = false, stop = false;
+    for (size_t i = 0; i < 3; ++i) {
+        const auto& field = header.fields[i];
+        const auto& buffer = buffers[i];
+        if ((field.name != "start" && field.name != "stop" && field.name != "planner") ||
+            !seen.insert(field.name).second || field.dtype != "u8" || field.shape != std::vector<size_t>{1} ||
+            buffer.size != 1 || !buffer.data) return false;
+        auto value = *static_cast<const uint8_t*>(buffer.data);
+        if (value > 1) return false;
+        if (field.name == "start") start = value;
+        if (field.name == "stop") stop = value;
+    }
+    return !(start && stop);
+}

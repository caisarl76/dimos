+++ b/gear_sonic_deploy/src/g1/g1_deploy_onnx_ref/unit_tests/test_guard_telemetry.cpp
@@ -0,0 +1,113 @@
+#include <gtest/gtest.h>
+#include <arpa/inet.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include <span>
+#include "../include/utils.hpp"
+#include "../include/robot_parameters.hpp"
+#include "../include/output_interface/zmq_output_handler.hpp"
+
+namespace {
+// Reserve an ephemeral test port without using SONIC's control/feedback ports.
+int FreeTestPort() {
+    const int fd = socket(AF_INET, SOCK_STREAM, 0);
+    if (fd < 0) throw std::runtime_error("test socket failed");
+    sockaddr_in address{};
+    address.sin_family = AF_INET;
+    address.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+    if (bind(fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0) {
+        close(fd);
+        throw std::runtime_error("test bind failed");
+    }
+    socklen_t size = sizeof(address);
+    const int result = getsockname(fd, reinterpret_cast<sockaddr*>(&address), &size);
+    close(fd);
+    if (result != 0) throw std::runtime_error("test getsockname failed");
+    return ntohs(address.sin_port);
+}
+
+class GuardTelemetry : public ::testing::TestWithParam<std::tuple<bool, bool, bool>> {};
+
+TEST_P(GuardTelemetry, CompleteMessagePreservesTorqueAndGuard) {
+    const auto [guarded, heading, hands_available] = GetParam();
+    StateLogger logger("", 2, 29, 29, 0.02, false, {{"test", true}});
+    std::array<double, 4> quat{1, 0, 0, 0};
+    std::array<double, 3> zero3{};
+    std::array<double, 29> body{}, torque{};
+    std::array<double, 58> temperature{};
+    std::array<double, 7> hand{}, left_tau{}, right_tau{};
+    for (size_t i = 0; i < torque.size(); ++i) torque[i] = i + 0.25;
+    for (size_t i = 0; i < hand.size(); ++i) {
+        left_tau[i] = i + 0.5;
+        right_tau[i] = -static_cast<double>(i) - 0.75;
+    }
+    const auto log_state = [&] {
+        std::array<std::chrono::steady_clock::time_point, 2> hand_times{};
+        if (hands_available) hand_times.fill(std::chrono::steady_clock::now());
+        logger.LogFullState(quat, zero3, zero3, quat, zero3, zero3,
+            body, body, body, temperature, body, torque,
+            hand, hand, hand, hand, hand, hand, 0.0, hand_times, left_tau, right_tau);
+    };
+    DataBuffer<HeadingState> headings;
+    if (heading) {
+        HeadingState state;
+        state.init_base_quat = quat;
+        state.delta_heading = 0.125;
+        headings.SetData(state);
+    }
+    const int port = FreeTestPort();
+    const std::string topic = "guard_test";
+    ZMQOutputHandler output(logger, port, topic);
+    if (guarded) output.SetReferenceGuardStatus({true, false, false, true, true, 123, 122, 7, 3, 12.5});
+    zmq::context_t context(1);
+    zmq::socket_t subscriber(context, ZMQ_SUB);
+    subscriber.set(zmq::sockopt::linger, 0);
+    subscriber.set(zmq::sockopt::subscribe, topic);
+    subscriber.set(zmq::sockopt::rcvtimeo, 100);
+    subscriber.connect("tcp://127.0.0.1:" + std::to_string(port));
+    zmq::message_t packet;
+    bool received = false;
+    for (int attempt = 0; attempt < 20 && !received; ++attempt) {
+        log_state();
+        output.publish({}, {}, {}, hand, hand, quat, headings, nullptr, 0);
+        received = subscriber.recv(packet).has_value();
+    }
+    ASSERT_TRUE(received);
+    ASSERT_GT(packet.size(), topic.size());
+    const auto* payload = static_cast<const char*>(packet.data()) + topic.size();
+    const size_t payload_size = packet.size() - topic.size();
+    size_t consumed = 0;
+    const auto decoded = msgpack::unpack(payload, payload_size, consumed);
+    ASSERT_EQ(consumed, payload_size) << "trailing fields indicate an incorrect MessagePack map count";
+    const auto fields = decoded.get().as<std::map<std::string, msgpack::object>>();
+    EXPECT_EQ(fields.at("motor_torque").as<std::vector<double>>(), (std::vector<double>(torque.begin(), torque.end())));
+    EXPECT_EQ(fields.at("left_hand_tau").as<std::vector<double>>(), (std::vector<double>(left_tau.begin(), left_tau.end())));
+    EXPECT_EQ(fields.at("right_hand_tau").as<std::vector<double>>(), (std::vector<double>(right_tau.begin(), right_tau.end())));
+    for (const auto* side : {"left", "right"}) {
+        const auto prefix = std::string(side) + "_hand_feedback_";
+        EXPECT_EQ(fields.at(prefix + "valid").as<bool>(), hands_available);
+        if (hands_available) EXPECT_GE(fields.at(prefix + "age_ns").as<int64_t>(), 0);
+        else EXPECT_EQ(fields.at(prefix + "age_ns").as<int64_t>(), -1);
+    }
+    EXPECT_EQ(fields.count("init_base_quat"), heading ? 1u : 0u);
+    EXPECT_EQ(fields.count("delta_heading"), heading ? 1u : 0u);
+    if (heading) EXPECT_DOUBLE_EQ(fields.at("delta_heading").as<double>(), 0.125);
+    EXPECT_EQ(fields.count("reference_guard"), guarded ? 1u : 0u);
+    if (guarded) {
+        const auto status = fields.at("reference_guard").as<std::map<std::string, msgpack::object>>();
+        ASSERT_EQ(status.size(), 10u);
+        EXPECT_TRUE(status.at("armed").as<bool>());
+        EXPECT_FALSE(status.at("expired").as<bool>());
+        EXPECT_FALSE(status.at("planner_selected").as<bool>());
+        EXPECT_TRUE(status.at("planner_confirmed").as<bool>());
+        EXPECT_TRUE(status.at("rearm_requires_planner").as<bool>());
+        EXPECT_EQ(status.at("accepted_index").as<int64_t>(), 123);
+        EXPECT_EQ(status.at("applied_index").as<int64_t>(), 122);
+        EXPECT_EQ(status.at("rejected").as<uint64_t>(), 7u);
+        EXPECT_EQ(status.at("epoch").as<uint64_t>(), 3u);
+        EXPECT_DOUBLE_EQ(status.at("age_ms").as<double>(), 12.5);
+    }
+}
+INSTANTIATE_TEST_SUITE_P(Pc2Wire, GuardTelemetry,
+    ::testing::Combine(::testing::Bool(), ::testing::Bool(), ::testing::Bool()));
+} // namespace

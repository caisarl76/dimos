diff -ruN a/unit_tests/test_planner_horizon.cpp b/unit_tests/test_planner_horizon.cpp
--- a/unit_tests/test_planner_horizon.cpp
+++ b/unit_tests/test_planner_horizon.cpp
@@ -0,0 +1,76 @@
+#include <gtest/gtest.h>
+
+#include "planner_horizon.hpp"
+
+namespace {
+PlannerHorizonSnapshot WalkingSnapshot() {
+  PlannerHorizonSnapshot state;
+  state.guarded = true;
+  state.active_planner = true;
+  state.playing = true;
+  state.mode = LocomotionMode::SLOW_WALK;
+  state.speed = 0.2;
+  state.remaining = 54;
+  state.window = 46;  // Enabled encoder: 10 samples, stride 5.
+  return state;
+}
+}  // namespace
+
+TEST(PlannerHorizon, RefreshesAt54ButNot55RemainingFrames) {
+  auto state = WalkingSnapshot();
+  auto decision = EvaluatePlannerHorizon(state, 0.1, 2);
+  EXPECT_EQ(decision.margin, 8);
+  EXPECT_TRUE(decision.refresh);
+  state.remaining = 55;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+}
+
+TEST(PlannerHorizon, UsesObservationWindowPeriodAndLookahead) {
+  auto state = WalkingSnapshot();
+  state.window = 21;
+  state.remaining = 30;
+  // ceil(0.11 * 50) + 2 + one apply tick = 9.
+  auto decision = EvaluatePlannerHorizon(state, 0.11, 2);
+  EXPECT_EQ(decision.margin, 9);
+  EXPECT_TRUE(decision.refresh);
+  state.remaining = 31;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.11, 2).refresh);
+  EXPECT_TRUE(EvaluatePlannerHorizon(state, 0.11, 3).refresh);
+}
+
+TEST(PlannerHorizon, LegacyIsDisabledByDefault) {
+  PlannerHorizonSnapshot defaults;
+  EXPECT_FALSE(defaults.guarded);
+  auto state = WalkingSnapshot();
+  state.guarded = defaults.guarded;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+}
+
+TEST(PlannerHorizon, NoFutureObservationWindowNeedsNoRefresh) {
+  auto state = WalkingSnapshot();
+  state.window = 0;
+  state.remaining = 1;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+}
+
+TEST(PlannerHorizon, ExcludesTurnIdleAndOtherLocomotionModes) {
+  auto state = WalkingSnapshot();
+  state.speed = 0.0;  // In-place turning has no translating horizon.
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+  state.speed = -1.0;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+  state.speed = 0.2;
+  state.mode = LocomotionMode::IDLE;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+  state.mode = LocomotionMode::RUN;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+}
+
+TEST(PlannerHorizon, RequiresActivePlayingPlannerMotion) {
+  auto state = WalkingSnapshot();
+  state.active_planner = false;  // Includes pose/streamed/current motion mismatch.
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+  state.active_planner = true;
+  state.playing = false;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+}
diff -ruN a/unit_tests/test_planner_lease_cases.cpp b/unit_tests/test_planner_lease_cases.cpp
--- a/unit_tests/test_planner_lease_cases.cpp
+++ b/unit_tests/test_planner_lease_cases.cpp
@@ -0,0 +1,49 @@
+#include <gtest/gtest.h>
+#include <nlohmann/json.hpp>
+#include <cstdlib>
+#include <fstream>
+#include "input_interface/planner_lease.hpp"
+
+TEST(PlannerLease, SharedDeadlineSequenceOracle) {
+    const char* path = std::getenv("SONIC_PLANNER_LEASE_CASES");
+    if (!path) path = SONIC_PLANNER_LEASE_CASES_DEFAULT;
+    std::ifstream stream(path);
+    ASSERT_TRUE(stream.good());
+    nlohmann::json oracle; stream >> oracle;
+    ASSERT_EQ(oracle.at("schema"), 1);
+    for (const auto& test_case : oracle.at("cases")) {
+        PlannerLease lease;
+        SCOPED_TRACE(test_case.at("name").get<std::string>());
+        for (const auto& step : test_case.at("steps")) {
+            SCOPED_TRACE(step.dump());
+            auto action = step.at("action").get<std::string>();
+            bool accepted = false;
+            double now = step.value("now", 0.0);
+            int64_t seq = step.value("sequence", int64_t{-1});
+            double deadline = step.value("deadline", 0.0);
+            if (action == "rearm") accepted = lease.Rearm(seq, deadline, now);
+            else if (action == "end") accepted = lease.End(seq, deadline, now);
+            else if (action == "install") accepted = lease.Install(now);
+            else if (action == "tick") lease.Tick(now);
+            else if (action == "pose") lease.EnterPose();
+            else if (action == "handback") lease.Handback(now);
+            else if (action == "ack_end") lease.AcknowledgeEnd();
+            else if (action == "idle" || action == "walk" || action == "legacy") {
+                GuardedPlannerPacket p;
+                if (action != "legacy") { p.sequence = seq; p.deadline = deadline; }
+                if (action == "walk") { p.mode = 1; p.movement = {1, 0, 0}; p.speed = .2f; }
+                accepted = lease.Accept(p, now);
+            } else FAIL() << "Unknown oracle action";
+            if (step.contains("accepted")) EXPECT_EQ(accepted, step.at("accepted"));
+            const auto& s = lease.status();
+            nlohmann::json actual = {
+                {"mode", s.mode}, {"high_water", s.high_water},
+                {"applied_sequence", s.applied_sequence}, {"rearm_barrier", s.rearm_barrier},
+                {"lease_armed", s.lease_armed}, {"latched", s.latched},
+                {"idle_ack_sequence", s.idle_ack_sequence}, {"fault", s.fault}
+            };
+            for (auto it = step.at("expect").begin(); it != step.at("expect").end(); ++it)
+                EXPECT_EQ(actual.at(it.key()), it.value()) << it.key();
+        }
+    }
+}
diff -ruN a/unit_tests/test_planner_lease.cpp b/unit_tests/test_planner_lease.cpp
--- a/unit_tests/test_planner_lease.cpp
+++ b/unit_tests/test_planner_lease.cpp
@@ -0,0 +1,115 @@
+#include <gtest/gtest.h>
+#include <limits>
+#include "input_interface/planner_lease.hpp"
+
+namespace {
+GuardedPlannerPacket Idle(int64_t seq, double deadline) {
+    GuardedPlannerPacket p;
+    p.sequence = seq; p.deadline = deadline;
+    return p;
+}
+GuardedPlannerPacket Walk(int64_t seq, double deadline) {
+    auto p = Idle(seq, deadline);
+    p.mode = 1; p.movement = {1, 0, 0}; p.speed = .2f;
+    return p;
+}
+void Begin(PlannerLease& lease, double now = 10) {
+    ASSERT_TRUE(lease.Rearm(10, now + .2, now));
+    ASSERT_TRUE(lease.Accept(Idle(11, now + .2), now));
+    ASSERT_TRUE(lease.Install(now));
+    ASSERT_TRUE(lease.status().lease_armed);
+}
+}
+
+TEST(PlannerLease, ExpiredPending) {
+    PlannerLease lease; Begin(lease);
+    ASSERT_TRUE(lease.Accept(Walk(12, 10.01), 10));
+    EXPECT_FALSE(lease.Install(10.015));
+    EXPECT_EQ(lease.status().mode, 0);
+    EXPECT_FALSE(lease.status().latched);
+    EXPECT_EQ(lease.status().applied_sequence, 11);
+}
+TEST(PlannerLease, HealthyHeartbeatMotionExpiry) {
+    PlannerLease lease; Begin(lease);
+    ASSERT_TRUE(lease.Accept(Walk(12, 10.01), 10));
+    ASSERT_TRUE(lease.Install(10));
+    lease.Tick(10.015);
+    EXPECT_EQ(lease.status().mode, 0);
+    EXPECT_FALSE(lease.status().latched);
+    EXPECT_TRUE(lease.status().lease_armed);
+    lease.Tick(10.251);
+    EXPECT_TRUE(lease.status().latched);
+    EXPECT_FALSE(lease.status().lease_armed);
+}
+TEST(PlannerLease, DuplicateDoesNotRenew) {
+    PlannerLease lease; Begin(lease);
+    EXPECT_FALSE(lease.Accept(Idle(11, 11), 10.2));
+    lease.Tick(10.251);
+    EXPECT_TRUE(lease.status().latched);
+}
+TEST(PlannerLease, RearmBarrier) {
+    PlannerLease lease;
+    ASSERT_TRUE(lease.Rearm(10, 10.2, 10));
+    EXPECT_FALSE(lease.Accept(Walk(11, 10.2), 10));
+    EXPECT_FALSE(lease.Accept(Idle(10, 10.2), 10));
+    ASSERT_TRUE(lease.Accept(Idle(11, 10.2), 10));
+    EXPECT_EQ(lease.status().idle_ack_sequence, 0);
+    ASSERT_TRUE(lease.Install(10));
+    EXPECT_EQ(lease.status().idle_ack_sequence, 11);
+    EXPECT_EQ(lease.status().rearm_barrier, 10);
+}
+TEST(PlannerLease, EndCannotClearLatch) {
+    PlannerLease lease; Begin(lease); lease.Tick(10.251);
+    ASSERT_TRUE(lease.End(12, 10.5, 10.3));
+    EXPECT_TRUE(lease.status().latched);
+    EXPECT_FALSE(lease.Accept(Walk(13, 10.5), 10.3));
+    ASSERT_TRUE(lease.Rearm(14, 10.5, 10.3));
+    EXPECT_TRUE(lease.status().latched);
+    ASSERT_TRUE(lease.Accept(Idle(15, 10.5), 10.3));
+    EXPECT_TRUE(lease.Install(10.3));
+    EXPECT_FALSE(lease.status().latched);
+}
+TEST(PlannerLease, PoseSuspendsPlannerLease) {
+    PlannerLease lease; Begin(lease); lease.EnterPose(); lease.Tick(20);
+    EXPECT_FALSE(lease.status().latched);
+    EXPECT_FALSE(lease.Accept(Idle(12, 20.2), 20));
+    EXPECT_FALSE(lease.Rearm(12, 20.2, 20));
+}
+TEST(PlannerLease, HandbackNeedsNewBegin) {
+    PlannerLease lease; Begin(lease); lease.EnterPose(); lease.Handback(20);
+    EXPECT_EQ(lease.status().high_water, 11);
+    EXPECT_FALSE(lease.Accept(Walk(12, 20.2), 20));
+    EXPECT_TRUE(lease.Rearm(12, 20.2, 20));
+}
+TEST(PlannerLease, LegacyPlannerRejected) {
+    PlannerLease lease; Begin(lease);
+    EXPECT_FALSE(lease.Accept(GuardedPlannerPacket{}, 10));
+}
+TEST(PlannerLease, RejectsInvalidIntentAndNonfiniteWithFastMath) {
+    PlannerLease lease; Begin(lease);
+    auto p = Walk(12, 10.2);
+    p.speed = std::numeric_limits<float>::quiet_NaN();
+    EXPECT_FALSE(lease.Accept(p, 10));
+    p = Walk(12, std::numeric_limits<double>::infinity());
+    EXPECT_FALSE(lease.Accept(p, 10));
+    p = Walk(12, 10.2); p.movement = {1, 0, .001f};
+    EXPECT_FALSE(lease.Accept(p, 10));
+    p = Idle(12, 10.2); p.speed = .1f;
+    EXPECT_FALSE(lease.Accept(p, 10));
+    p = Walk(12, 10.2); p.speed = .201f;
+    EXPECT_FALSE(lease.Accept(p, 10));
+    p = Walk(12, 10.2); p.height = 0;
+    EXPECT_FALSE(lease.Accept(p, 10));
+    EXPECT_EQ(lease.status().high_water, 11);
+}
+TEST(PlannerLease, CapsFutureDeadlineAndBoundsRearmWindow) {
+    PlannerLease lease; Begin(lease);
+    ASSERT_TRUE(lease.Accept(Walk(12, 100), 10));
+    ASSERT_TRUE(lease.Install(10));
+    lease.Tick(10.251);
+    EXPECT_EQ(lease.status().mode, 0);
+    EXPECT_TRUE(lease.status().latched);
+    ASSERT_TRUE(lease.Rearm(13, 100, 20));
+    EXPECT_FALSE(lease.Accept(Idle(14, 100), 20.251));
+    EXPECT_TRUE(lease.status().latched);
+}
diff -ruN a/unit_tests/test_planner_packet.cpp b/unit_tests/test_planner_packet.cpp
--- a/unit_tests/test_planner_packet.cpp
+++ b/unit_tests/test_planner_packet.cpp
@@ -0,0 +1,52 @@
+#include <gtest/gtest.h>
+#include "input_interface/planner_packet.hpp"
+
+namespace {
+struct PlannerFrame {
+    guarded_planner::Header header{1,"le",1,{
+        {"mode","i32",{1}}, {"movement","f32",{3}}, {"facing","f32",{3}},
+        {"speed","f32",{1}}, {"height","f32",{1}},
+        {"planner_sequence","i64",{1}}, {"planner_deadline","f64",{1}}}};
+    GuardedPlannerPacket packet;
+    std::vector<guarded_planner::Buffer> buffers{
+        {&packet.mode,4},{packet.movement.data(),12},{packet.facing.data(),12},
+        {&packet.speed,4},{&packet.height,4},{&packet.sequence,8},{&packet.deadline,8}};
+};
+}
+TEST(PlannerLease, ParserRejectsMalformedLayoutBeforeReadingPayload) {
+    PlannerFrame frame;
+    ASSERT_TRUE(guarded_planner::Planner(frame.header,frame.buffers));
+    frame.header.fields[1].shape = {1,3};
+    EXPECT_FALSE(guarded_planner::Planner(frame.header,frame.buffers));
+    frame.header.fields[1].shape = {3};
+    frame.buffers[0].size = 1;
+    EXPECT_FALSE(guarded_planner::Planner(frame.header,frame.buffers));
+    frame.buffers[0].size = 4;
+    frame.header.fields[5].name = "mode";
+    EXPECT_FALSE(guarded_planner::Planner(frame.header,frame.buffers));
+    frame.header.fields[5].name = "planner_sequence";
+    frame.header.endian = "be";
+    EXPECT_FALSE(guarded_planner::Planner(frame.header,frame.buffers));
+    frame.header.endian = "le";
+    frame.header.version = 2;
+    EXPECT_FALSE(guarded_planner::Planner(frame.header,frame.buffers));
+}
+TEST(PlannerLease, ControlParserCannotStartOrStopMotors) {
+    guarded_planner::Header header{1,"le",1,{
+        {"start","u8",{1}},{"stop","u8",{1}},{"planner","u8",{1}},
+        {"navigation_control","i32",{1}},{"planner_sequence","i64",{1}},
+        {"planner_deadline","f64",{1}}}};
+    uint8_t start = 0, stop = 0, planner = 1;
+    int32_t control = 1; int64_t seq = 10; double deadline = 10.2;
+    std::vector<guarded_planner::Buffer> buffers{
+        {&start,1},{&stop,1},{&planner,1},{&control,4},{&seq,8},{&deadline,8}};
+    ASSERT_TRUE(guarded_planner::Control(header,buffers));
+    start = 1;
+    EXPECT_FALSE(guarded_planner::Control(header,buffers));
+    start = 0; stop = 1;
+    EXPECT_FALSE(guarded_planner::Control(header,buffers));
+    stop = 0; planner = 0;
+    EXPECT_FALSE(guarded_planner::Control(header,buffers));
+    planner = 1; control = 3;
+    EXPECT_FALSE(guarded_planner::Control(header,buffers));
+}
diff -ruN a/unit_tests/test_planner_receiver.cpp b/unit_tests/test_planner_receiver.cpp
--- a/unit_tests/test_planner_receiver.cpp
+++ b/unit_tests/test_planner_receiver.cpp
@@ -0,0 +1,103 @@
+#include <gtest/gtest.h>
+#include "input_interface/zmq_manager.hpp"
+
+namespace {
+double Now() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+template<class Predicate> bool Wait(Predicate predicate) {
+    const auto limit = Now() + 1;
+    while (Now() < limit) {
+        if (predicate()) return true;
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    return false;
+}
+template<class T> void Bytes(std::vector<char>& data, const T& value) {
+    const auto* ptr = reinterpret_cast<const char*>(&value);
+    data.insert(data.end(), ptr, ptr + sizeof(value));
+}
+void Send(zmq::socket_t& socket, const std::string& topic, nlohmann::json fields, std::vector<char> payload) {
+    const auto header = nlohmann::json{{"v",1},{"endian","le"},{"count",1},{"fields",fields}}.dump();
+    std::vector<char> packet(topic.begin(), topic.end());
+    packet.resize(topic.size() + 1280, 0);
+    std::memcpy(packet.data() + topic.size(), header.data(), header.size());
+    packet.insert(packet.end(), payload.begin(), payload.end());
+    socket.send(zmq::buffer(packet), zmq::send_flags::none);
+}
+nlohmann::json F(const char* name, const char* dtype, int count) {
+    return { {"name",name},{"dtype",dtype},{"shape",{count}} };
+}
+void Control(zmq::socket_t& socket, int action, int64_t sequence, double deadline) {
+    std::vector<char> payload;
+    Bytes(payload,uint8_t{0}); Bytes(payload,uint8_t{0}); Bytes(payload,uint8_t{1});
+    Bytes(payload,int32_t{action}); Bytes(payload,sequence); Bytes(payload,deadline);
+    Send(socket,"command",{F("start","u8",1),F("stop","u8",1),F("planner","u8",1),
+        F("navigation_control","i32",1),F("planner_sequence","i64",1),F("planner_deadline","f64",1)},payload);
+}
+void Planner(zmq::socket_t& socket, int mode, int64_t sequence, double deadline, bool trailing = false) {
+    std::vector<char> payload;
+    Bytes(payload,int32_t{mode});
+    Bytes(payload,std::array<float,3>{mode ? 1.f : 0.f,0,0});
+    Bytes(payload,std::array<float,3>{1,0,0});
+    Bytes(payload,mode ? .2f : 0.f); Bytes(payload,-1.f);
+    Bytes(payload,sequence); Bytes(payload,deadline);
+    if (trailing) Bytes(payload,uint8_t{1});
+    Send(socket,"planner",{F("mode","i32",1),F("movement","f32",3),F("facing","f32",3),
+        F("speed","f32",1),F("height","f32",1),F("planner_sequence","i64",1),
+        F("planner_deadline","f64",1)},payload);
+}
+}
+
+TEST(PlannerLease, ReceiverAcknowledgesOnlyInstalledIdleAndStopsOnEnd) {
+    zmq::context_t context(1);
+    zmq::socket_t peer(context, zmq::socket_type::xpub);
+    peer.set(zmq::sockopt::linger, 0);
+    peer.bind("tcp://127.0.0.1:*");
+    const auto address = peer.get(zmq::sockopt::last_endpoint);
+    const int port = std::stoi(address.substr(address.rfind(':') + 1));
+    ZMQManager manager("127.0.0.1",port,"pose","command","planner",false,false,200,true);
+    bool command = false, planner = false;
+    ASSERT_TRUE(Wait([&] {
+        zmq::message_t subscription;
+        if (peer.recv(subscription,zmq::recv_flags::dontwait) && subscription.size() > 1) {
+            const auto* bytes = static_cast<const char*>(subscription.data());
+            const std::string topic(bytes + 1, subscription.size() - 1);
+            if (bytes[0] == 1 && topic == "command") command = true;
+            if (bytes[0] == 1 && topic == "planner") planner = true;
+        }
+        return command && planner;
+    }));
+    manager.SetPlannerHeading(euler_z_to_quat_d(.5),euler_z_to_quat_d(.2));
+    MotionDataReader reader;
+    std::shared_ptr<const MotionSequence> motion = std::make_shared<MotionSequence>();
+    int frame = 0; OperatorState op; bool reset = false, temperature = false;
+    DataBuffer<HeadingState> heading; DataBuffer<MovementState> movement;
+    PlannerState state{true,true}; std::mutex mutex;
+    auto apply = [&] {
+        manager.update();
+        manager.handle_input(reader,motion,frame,op,reset,heading,true,state,movement,mutex,temperature);
+    };
+    Control(peer,1,10,Now()+.2);
+    ASSERT_TRUE(Wait([&] { return manager.GetPlannerGuardStatus().high_water == 10; }));
+    Planner(peer,0,11,Now()+.2);
+    ASSERT_TRUE(Wait([&] { return manager.GetPlannerGuardStatus().high_water == 11; }));
+    EXPECT_EQ(manager.GetPlannerGuardStatus().idle_ack_sequence,0);
+    apply();
+    ASSERT_EQ(manager.GetPlannerGuardStatus().idle_ack_sequence,11);
+    ASSERT_TRUE(manager.GetPlannerGuardStatus().lease_armed);
+    Planner(peer,1,12,Now()+.2);
+    ASSERT_TRUE(Wait([&] { return manager.GetPlannerGuardStatus().high_water == 12; }));
+    apply();
+    ASSERT_EQ(movement.GetDataWithTime().data->locomotion_mode,1);
+    Control(peer,2,13,Now()+.2);
+    ASSERT_TRUE(Wait([&] { return manager.GetPlannerGuardStatus().high_water == 13; }));
+    EXPECT_EQ(manager.GetPlannerGuardStatus().idle_ack_sequence,11);
+    apply();
+    EXPECT_EQ(manager.GetPlannerGuardStatus().idle_ack_sequence,13);
+    EXPECT_EQ(movement.GetDataWithTime().data->locomotion_mode,0);
+    EXPECT_DOUBLE_EQ(movement.GetDataWithTime().data->facing_direction[0],std::cos(.3));
+    manager.SetPlannerHeading(euler_z_to_quat_d(.8),euler_z_to_quat_d(.2));
+    apply();
+    EXPECT_DOUBLE_EQ(movement.GetDataWithTime().data->facing_direction[0],std::cos(.3));
+}
diff -ruN a/unit_tests/test_planner_terminal_hold.cpp b/unit_tests/test_planner_terminal_hold.cpp
--- a/unit_tests/test_planner_terminal_hold.cpp
+++ b/unit_tests/test_planner_terminal_hold.cpp
@@ -0,0 +1,75 @@
+#include <gtest/gtest.h>
+
+#include "localmotion_kplanner.hpp"
+
+namespace {
+// Supply deterministic backend output; exercise the real native resampler.
+// No controller, inference engine, DDS connection or GPU is constructed.
+class TerminalPlanner : public LocalMotionPlannerBase {
+ public:
+  explicit TerminalPlanner(bool hold_terminal = true) {
+    config_.zero_terminal_velocity = hold_terminal;
+    for (int frame = 0; frame < 3; ++frame) {
+      output_[frame * 36 + 2] = 0.79f;
+      output_[frame * 36 + 3] = 1.0f;
+      for (int joint = 0; joint < 29; ++joint) {
+        output_[frame * 36 + 7 + joint] = 0.01f * frame * (joint + 1);
+      }
+    }
+  }
+
+  bool InitializeSpecific() override { return true; }
+  void RunInference() override {}
+  void UpdateInputTensors(int, float, float, const std::array<float, 3>&,
+                         const std::array<float, 3>&, int) override {}
+  float* GetContextBuffer() override { return context_.data(); }
+  int32_t GetNumPredFrames() override { return 3; }
+  const float* GetMujocoQposBuffer() override { return output_.data(); }
+  float* GetMovementDirectionValues() override { return direction_.data(); }
+  float* GetFacingDirectionValues() override { return direction_.data(); }
+  float GetTargetVelValue() override { return 0; }
+  float GetHeightValue() override { return -1; }
+  int32_t GetRandomSeedValue() override { return 1234; }
+  int32_t GetModeValue() override { return 0; }
+
+ private:
+  std::array<float, 108> output_{};
+  std::array<float, 144> context_{};
+  std::array<float, 3> direction_{1, 0, 0};
+};
+}  // namespace
+
+TEST(PlannerTerminalHold, FullBodyAndLowerBodyTerminalReferenceHasZeroVelocity) {
+  TerminalPlanner planner;
+  ASSERT_TRUE(planner.ResampleGeneratedSequence50Hz());
+  const auto& motion = planner.planner_motion_50hz_;
+  ASSERT_EQ(motion.timesteps, 5);
+  // Every clamped future sample in both enabled encoder features reads this
+  // same terminal buffer. Assert the buffer invariant, not a copy of gather.
+  for (int joint = 0; joint < 29; ++joint) {
+    EXPECT_DOUBLE_EQ(motion.JointVelocities(4)[joint], 0.0) << joint;
+  }
+  for (int joint : lower_body_joint_mujoco_order_in_isaaclab_index) {
+    EXPECT_DOUBLE_EQ(motion.JointVelocities(4)[joint], 0.0) << joint;
+  }
+}
+
+TEST(PlannerTerminalHold, KeepsMovingSamplesAndTerminalPositions) {
+  TerminalPlanner planner;
+  ASSERT_TRUE(planner.ResampleGeneratedSequence50Hz());
+  const auto& motion = planner.planner_motion_50hz_;
+  // Joint 0 moves 0.01 rad per 30 Hz frame: 0.3 rad/s. The last
+  // in-range interval is 0.018 -> 0.020 over 0.02 s: 0.1 rad/s.
+  EXPECT_NEAR(motion.JointVelocities(0)[0], 0.3, 1e-6);
+  EXPECT_NEAR(motion.JointVelocities(3)[0], 0.1, 1e-6);
+  EXPECT_NEAR(motion.JointPositions(4)[0], 0.02, 1e-6);
+  EXPECT_NEAR(motion.JointPositions(4)[28], 0.58, 1e-6);
+}
+
+TEST(PlannerTerminalHold, LegacyPlannerKeepsItsTerminalVelocity) {
+  TerminalPlanner planner(false);
+  ASSERT_TRUE(planner.ResampleGeneratedSequence50Hz());
+  const auto& motion = planner.planner_motion_50hz_;
+  EXPECT_NEAR(motion.JointVelocities(4)[0], 0.1, 1e-6);
+  EXPECT_NEAR(motion.JointVelocities(3)[0], 0.1, 1e-6);
+}

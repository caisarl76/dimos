diff -ruN a/include/planner_horizon.hpp b/include/planner_horizon.hpp
--- a/include/planner_horizon.hpp
+++ b/include/planner_horizon.hpp
@@ -0,0 +1,33 @@
+#ifndef PLANNER_HORIZON_HPP
+#define PLANNER_HORIZON_HPP
+
+#include "localmotion_kplanner.hpp"
+
+// Snapshot under current_motion_mutex_; evaluation performs no inference.
+struct PlannerHorizonSnapshot {
+  bool guarded = false;
+  bool active_planner = false;
+  bool playing = false;
+  LocomotionMode mode = LocomotionMode::IDLE;
+  double speed = 0.0;
+  int remaining = 0;  // Includes the current frame.
+  int window = 0;     // Includes the current frame.
+};
+
+struct PlannerHorizonDecision {
+  bool refresh = false;
+  int margin = 0;
+};
+
+inline PlannerHorizonDecision EvaluatePlannerHorizon(
+    const PlannerHorizonSnapshot& state, double planner_dt, int lookahead) {
+  // Cover one planner polling period, generation lookahead, and one control
+  // tick for applying the result. This is a scheduling reserve, not a hard
+  // real-time latency guarantee.
+  const int margin = static_cast<int>(std::ceil(planner_dt * 50.0)) + lookahead + 1;
+  const bool eligible = state.guarded && state.active_planner && state.playing &&
+      state.mode == LocomotionMode::SLOW_WALK && state.speed > 0.0 && state.window > 0;
+  return {eligible && state.remaining <= state.window + margin, margin};
+}
+
+#endif  // PLANNER_HORIZON_HPP

@@ -0,0 +1,76 @@
+#include <gtest/gtest.h>
+
+#include "planner_horizon.hpp"
+
+namespace {
+PlannerHorizonSnapshot WalkingSnapshot() {
+  PlannerHorizonSnapshot state;
+  state.guarded = true;
+  state.active_planner = true;
+  state.playing = true;
+  state.mode = LocomotionMode::SLOW_WALK;
+  state.speed = 0.2;
+  state.remaining = 54;
+  state.window = 46;  // Enabled encoder: 10 samples, stride 5.
+  return state;
+}
+}  // namespace
+
+TEST(PlannerHorizon, RefreshesAt54ButNot55RemainingFrames) {
+  auto state = WalkingSnapshot();
+  auto decision = EvaluatePlannerHorizon(state, 0.1, 2);
+  EXPECT_EQ(decision.margin, 8);
+  EXPECT_TRUE(decision.refresh);
+  state.remaining = 55;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+}
+
+TEST(PlannerHorizon, UsesObservationWindowPeriodAndLookahead) {
+  auto state = WalkingSnapshot();
+  state.window = 21;
+  state.remaining = 30;
+  // ceil(0.11 * 50) + 2 + one apply tick = 9.
+  auto decision = EvaluatePlannerHorizon(state, 0.11, 2);
+  EXPECT_EQ(decision.margin, 9);
+  EXPECT_TRUE(decision.refresh);
+  state.remaining = 31;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.11, 2).refresh);
+  EXPECT_TRUE(EvaluatePlannerHorizon(state, 0.11, 3).refresh);
+}
+
+TEST(PlannerHorizon, LegacyIsDisabledByDefault) {
+  PlannerHorizonSnapshot defaults;
+  EXPECT_FALSE(defaults.guarded);
+  auto state = WalkingSnapshot();
+  state.guarded = defaults.guarded;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+}
+
+TEST(PlannerHorizon, NoFutureObservationWindowNeedsNoRefresh) {
+  auto state = WalkingSnapshot();
+  state.window = 0;
+  state.remaining = 1;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+}
+
+TEST(PlannerHorizon, ExcludesTurnIdleAndOtherLocomotionModes) {
+  auto state = WalkingSnapshot();
+  state.speed = 0.0;  // In-place turning has no translating horizon.
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+  state.speed = -1.0;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+  state.speed = 0.2;
+  state.mode = LocomotionMode::IDLE;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+  state.mode = LocomotionMode::RUN;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+}
+
+TEST(PlannerHorizon, RequiresActivePlayingPlannerMotion) {
+  auto state = WalkingSnapshot();
+  state.active_planner = false;  // Includes pose/streamed/current motion mismatch.
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+  state.active_planner = true;
+  state.playing = false;
+  EXPECT_FALSE(EvaluatePlannerHorizon(state, 0.1, 2).refresh);
+}

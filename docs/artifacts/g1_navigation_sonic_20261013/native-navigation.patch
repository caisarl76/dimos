+#include <gtest/gtest.h>
+#include <nlohmann/json.hpp>
+#include <cstdlib>
+#include <fstream>
+#include "input_interface/planner_lease.hpp"
+
+TEST(PlannerLease, SharedDeadlineSequenceOracle) {
+    const char* path = std::getenv("SONIC_PLANNER_LEASE_CASES");
+    if (!path) path = SONIC_PLANNER_LEASE_CASES_DEFAULT;
+    std::ifstream stream(path);
+    ASSERT_TRUE(stream.good());
+    nlohmann::json oracle; stream >> oracle;
+    ASSERT_EQ(oracle.at("schema"), 1);
+    for (const auto& test_case : oracle.at("cases")) {
+        PlannerLease lease;
+        SCOPED_TRACE(test_case.at("name").get<std::string>());
+        for (const auto& step : test_case.at("steps")) {
+            SCOPED_TRACE(step.dump());
+            auto action = step.at("action").get<std::string>();
+            bool accepted = false;
+            double now = step.value("now", 0.0);
+            int64_t seq = step.value("sequence", int64_t{-1});
+            double deadline = step.value("deadline", 0.0);
+            if (action == "rearm") accepted = lease.Rearm(seq, deadline, now);
+            else if (action == "end") accepted = lease.End(seq, deadline, now);
+            else if (action == "install") accepted = lease.Install(now);
+            else if (action == "tick") lease.Tick(now);
+            else if (action == "pose") lease.EnterPose();
+            else if (action == "handback") lease.Handback(now);
+            else if (action == "ack_end") lease.AcknowledgeEnd();
+            else if (action == "idle" || action == "walk" || action == "legacy") {
+                GuardedPlannerPacket p;
+                if (action != "legacy") { p.sequence = seq; p.deadline = deadline; }
+                if (action == "walk") { p.mode = 1; p.movement = {1, 0, 0}; p.speed = .2f; }
+                accepted = lease.Accept(p, now);
+            } else FAIL() << "Unknown oracle action";
+            if (step.contains("accepted")) EXPECT_EQ(accepted, step.at("accepted"));
+            const auto& s = lease.status();
+            nlohmann::json actual = {
+                {"mode", s.mode}, {"high_water", s.high_water},
+                {"applied_sequence", s.applied_sequence}, {"rearm_barrier", s.rearm_barrier},
+                {"lease_armed", s.lease_armed}, {"latched", s.latched},
+                {"idle_ack_sequence", s.idle_ack_sequence}, {"fault", s.fault}
+            };
+            for (auto it = step.at("expect").begin(); it != step.at("expect").end(); ++it)
+                EXPECT_EQ(actual.at(it.key()), it.value()) << it.key();
+        }
+    }
+}

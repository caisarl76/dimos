+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+// All methods are called with the manager's planner mutex held. Clocks are
+// CLOCK_MONOTONIC seconds shared by the publisher and native process on pc2.
+struct GuardedPlannerPacket {
+    int32_t mode = 0;
+    std::array<float, 3> movement = {0, 0, 0};
+    std::array<float, 3> facing = {1, 0, 0};
+    float speed = 0;
+    float height = -1;
+    int64_t sequence = -1;
+    double deadline = 0;
+};
+
+struct PlannerGuardStatus {
+    int32_t mode = 0;
+    int64_t high_water = 0;
+    int64_t applied_sequence = 0;
+    int64_t rearm_barrier = 0;
+    bool lease_armed = false;
+    bool latched = false;
+    int64_t idle_ack_sequence = 0;
+    std::string fault = "disarmed";
+};
+
+class PlannerLease {
+public:
+    static constexpr double kLeaseSeconds = .250;
+
+    // Bit checks remain effective with the deployment project's -ffast-math.
+    static bool Finite(double x) {
+        return (std::bit_cast<uint64_t>(x) & 0x7ff0000000000000ULL) != 0x7ff0000000000000ULL;
+    }
+    static bool Finite(float x) {
+        return (std::bit_cast<uint32_t>(x) & 0x7f800000U) != 0x7f800000U;
+    }
+    static bool ValidIntent(const GuardedPlannerPacket& p) {
+        if ((p.mode != 0 && p.mode != 1) || !Finite(p.speed) || !Finite(p.height) || p.height != -1.f) return false;
+        for (float v : p.movement) if (!Finite(v)) return false;
+        auto horizontal_unit = [](const auto& v) {
+            return Finite(v[0]) && Finite(v[1]) && Finite(v[2]) && v[2] == 0.f &&
+                std::abs(v[0] * v[0] + v[1] * v[1] - 1.f) <= .0001f;
+        };
+        if (!horizontal_unit(p.facing)) return false;
+        if (p.mode == 0) {
+            return p.speed == 0.f && p.movement == std::array<float, 3>{0, 0, 0};
+        }
+        return p.speed >= .1f && p.speed <= .2f && horizontal_unit(p.movement);
+    }
+
+    bool Rearm(int64_t sequence, double deadline, double now) {
+        Tick(now);
+        if (pose_ || !Fresh(sequence, deadline, now)) return false;
+        s_.high_water = sequence;
+        s_.rearm_barrier = sequence;
+        s_.lease_armed = false;
+        awaiting_idle_ = true;
+        rearm_deadline_ = std::min(deadline, now + kLeaseSeconds);
+        last_receipt_ = now;
+        ForceIdle();
+        pending_.reset();
+        if (!s_.latched) s_.fault = "awaiting_idle";
+        return true;
+    }
+
+    bool Accept(const GuardedPlannerPacket& packet, double now) {
+        Tick(now);
+        if (pose_ || !Fresh(packet.sequence, packet.deadline, now) || !ValidIntent(packet)) return false;
+        if (awaiting_idle_) {
+            if (now >= rearm_deadline_ || packet.mode != 0) return false;
+        } else if (!s_.lease_armed || s_.latched) {
+            return false;
+        }
+        s_.high_water = packet.sequence;
+        last_receipt_ = now;
+        pending_ = packet;
+        pending_->deadline = std::min(packet.deadline, now + kLeaseSeconds);
+        return true;
+    }
+
+    // Acknowledgment means installation in the controller input buffer, never
+    // merely reception by the subscriber thread. Expired pending data is lost.
+    bool Install(double now) {
+        Tick(now);
+        if (!pending_) return false;
+        auto packet = *pending_;
+        pending_.reset();
+        if (pose_ || packet.deadline <= now || (!awaiting_idle_ && !s_.lease_armed)) return false;
+        if (awaiting_idle_) {
+            if (now >= rearm_deadline_ || packet.mode != 0) return false;
+            awaiting_idle_ = false;
+            s_.lease_armed = true;
+            s_.latched = false;
+            s_.fault.clear();
+        }
+        active_ = packet;
+        s_.mode = packet.mode;
+        s_.applied_sequence = packet.sequence;
+        if (packet.mode == 0) s_.idle_ack_sequence = packet.sequence;
+        return true;
+    }
+
+    bool End(int64_t sequence, double deadline, double now) {
+        Tick(now);
+        if (pose_ || !Fresh(sequence, deadline, now)) return false;
+        s_.high_water = sequence;
+        Close();
+        if (!s_.latched) s_.fault = "ended";
+        // End is installed by the manager's next input tick before status is
+        // published. The manager calls AcknowledgeEnd only after buffer update.
+        end_ack_ = sequence;
+        return true;
+    }
+    void AcknowledgeEnd() {
+        if (end_ack_) {
+            s_.applied_sequence = *end_ack_;
+            s_.idle_ack_sequence = *end_ack_;
+            end_ack_.reset();
+        }
+    }
+    void EnterPose() {
+        Close();
+        pose_ = true;
+        if (!s_.latched) s_.fault = "pose";
+    }
+    void Fault(const std::string& reason) {
+        Close();
+        s_.latched = true;
+        s_.fault = reason;
+    }
+    void Handback(double /*now*/) {
+        Close();
+        pose_ = false;
+        if (!s_.latched) s_.fault = "handback";
+    }
+    void Tick(double now) {
+        if (!Finite(now) || pose_) return;
+        if ((s_.lease_armed && now - last_receipt_ >= kLeaseSeconds) ||
+            (awaiting_idle_ && now >= rearm_deadline_)) {
+            Close();
+            s_.latched = true;
+            s_.fault = "planner_watchdog";
+        } else if (active_.deadline > 0 && now >= active_.deadline) {
+            ForceIdle();
+        }
+    }
+    const PlannerGuardStatus& status() const { return s_; }
+    const GuardedPlannerPacket& active() const { return active_; }
+    uint64_t idle_generation() const { return idle_generation_; }
+
+private:
+    bool Fresh(int64_t sequence, double deadline, double now) const {
+        return sequence > s_.high_water && Finite(now) && Finite(deadline) && deadline > now;
+    }
+    void ForceIdle() {
+        active_.mode = 0;
+        active_.movement = {0, 0, 0};
+        active_.speed = 0;
+        active_.deadline = 0;
+        s_.mode = 0;
+        ++idle_generation_;
+    }
+    void Close() {
+        s_.lease_armed = false;
+        awaiting_idle_ = false;
+        pending_.reset();
+        end_ack_.reset();
+        ForceIdle();
+    }
+    PlannerGuardStatus s_;
+    GuardedPlannerPacket active_;
+    std::optional<GuardedPlannerPacket> pending_;
+    std::optional<int64_t> end_ack_;
+    double last_receipt_ = 0;
+    double rearm_deadline_ = 0;
+    bool awaiting_idle_ = false;
+    bool pose_ = false;
+    uint64_t idle_generation_ = 1;
+};

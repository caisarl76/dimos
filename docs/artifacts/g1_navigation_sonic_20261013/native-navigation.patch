+#pragma once
+#include "planner_lease.hpp"
+#include "zmq_packed_message_subscriber.hpp"
+
+namespace guarded_planner {
+using Header = ZMQPackedMessageSubscriber::DecodedHeader;
+using Buffer = ZMQPackedMessageSubscriber::BufferView;
+
+inline bool Field(const Header& h, const std::vector<Buffer>& b, size_t i,
+                  const char* name, const char* dtype, size_t count, size_t bytes) {
+    return i < h.fields.size() && i < b.size() && h.fields[i].name == name &&
+        h.fields[i].dtype == dtype && h.fields[i].shape == std::vector<size_t>{count} &&
+        !h.fields[i].optional && b[i].data && b[i].size == bytes;
+}
+template<class T> inline T Scalar(const Buffer& b) {
+    T value; std::memcpy(&value, b.data, sizeof(value)); return value;
+}
+inline std::optional<GuardedPlannerPacket> Planner(const Header& h, const std::vector<Buffer>& b) {
+    if (h.version != 1 || h.count != 1 || h.endian != "le" || !is_little_endian() ||
+        h.fields.size() != 7 || b.size() != 7 ||
+        !Field(h,b,0,"mode","i32",1,4) || !Field(h,b,1,"movement","f32",3,12) ||
+        !Field(h,b,2,"facing","f32",3,12) || !Field(h,b,3,"speed","f32",1,4) ||
+        !Field(h,b,4,"height","f32",1,4) || !Field(h,b,5,"planner_sequence","i64",1,8) ||
+        !Field(h,b,6,"planner_deadline","f64",1,8)) return {};
+    GuardedPlannerPacket p;
+    p.mode = Scalar<int32_t>(b[0]);
+    std::memcpy(p.movement.data(), b[1].data, 12);
+    std::memcpy(p.facing.data(), b[2].data, 12);
+    p.speed = Scalar<float>(b[3]); p.height = Scalar<float>(b[4]);
+    p.sequence = Scalar<int64_t>(b[5]); p.deadline = Scalar<double>(b[6]);
+    if (!PlannerLease::ValidIntent(p)) return {};
+    return p;
+}
+struct ControlPacket { int32_t action; int64_t sequence; double deadline; };
+inline std::optional<ControlPacket> Control(const Header& h, const std::vector<Buffer>& b) {
+    if (h.version != 1 || h.count != 1 || h.endian != "le" || !is_little_endian() ||
+        h.fields.size() != 6 || b.size() != 6 ||
+        !Field(h,b,0,"start","u8",1,1) || !Field(h,b,1,"stop","u8",1,1) ||
+        !Field(h,b,2,"planner","u8",1,1) || !Field(h,b,3,"navigation_control","i32",1,4) ||
+        !Field(h,b,4,"planner_sequence","i64",1,8) || !Field(h,b,5,"planner_deadline","f64",1,8) ||
+        Scalar<uint8_t>(b[0]) != 0 || Scalar<uint8_t>(b[1]) != 0 || Scalar<uint8_t>(b[2]) != 1) return {};
+    ControlPacket p{Scalar<int32_t>(b[3]), Scalar<int64_t>(b[4]), Scalar<double>(b[5])};
+    if ((p.action != 1 && p.action != 2) || p.sequence < 0 || !PlannerLease::Finite(p.deadline)) return {};
+    return p;
+}
+}

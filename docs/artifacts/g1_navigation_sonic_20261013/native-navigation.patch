+#include <gtest/gtest.h>
+#include <limits>
+#include "input_interface/planner_lease.hpp"
+
+namespace {
+GuardedPlannerPacket Idle(int64_t seq, double deadline) {
+    GuardedPlannerPacket p;
+    p.sequence = seq; p.deadline = deadline;
+    return p;
+}
+GuardedPlannerPacket Walk(int64_t seq, double deadline) {
+    auto p = Idle(seq, deadline);
+    p.mode = 1; p.movement = {1, 0, 0}; p.speed = .2f;
+    return p;
+}
+void Begin(PlannerLease& lease, double now = 10) {
+    ASSERT_TRUE(lease.Rearm(10, now + .2, now));
+    ASSERT_TRUE(lease.Accept(Idle(11, now + .2), now));
+    ASSERT_TRUE(lease.Install(now));
+    ASSERT_TRUE(lease.status().lease_armed);
+}
+}
+
+TEST(PlannerLease, ExpiredPending) {
+    PlannerLease lease; Begin(lease);
+    ASSERT_TRUE(lease.Accept(Walk(12, 10.01), 10));
+    EXPECT_FALSE(lease.Install(10.015));
+    EXPECT_EQ(lease.status().mode, 0);
+    EXPECT_FALSE(lease.status().latched);
+    EXPECT_EQ(lease.status().applied_sequence, 11);
+}
+TEST(PlannerLease, HealthyHeartbeatMotionExpiry) {
+    PlannerLease lease; Begin(lease);
+    ASSERT_TRUE(lease.Accept(Walk(12, 10.01), 10));
+    ASSERT_TRUE(lease.Install(10));
+    lease.Tick(10.015);
+    EXPECT_EQ(lease.status().mode, 0);
+    EXPECT_FALSE(lease.status().latched);
+    EXPECT_TRUE(lease.status().lease_armed);
+    lease.Tick(10.251);
+    EXPECT_TRUE(lease.status().latched);
+    EXPECT_FALSE(lease.status().lease_armed);
+}
+TEST(PlannerLease, DuplicateDoesNotRenew) {
+    PlannerLease lease; Begin(lease);
+    EXPECT_FALSE(lease.Accept(Idle(11, 11), 10.2));
+    lease.Tick(10.251);
+    EXPECT_TRUE(lease.status().latched);
+}
+TEST(PlannerLease, RearmBarrier) {
+    PlannerLease lease;
+    ASSERT_TRUE(lease.Rearm(10, 10.2, 10));
+    EXPECT_FALSE(lease.Accept(Walk(11, 10.2), 10));
+    EXPECT_FALSE(lease.Accept(Idle(10, 10.2), 10));
+    ASSERT_TRUE(lease.Accept(Idle(11, 10.2), 10));
+    EXPECT_EQ(lease.status().idle_ack_sequence, 0);
+    ASSERT_TRUE(lease.Install(10));
+    EXPECT_EQ(lease.status().idle_ack_sequence, 11);
+    EXPECT_EQ(lease.status().rearm_barrier, 10);
+}
+TEST(PlannerLease, EndCannotClearLatch) {
+    PlannerLease lease; Begin(lease); lease.Tick(10.251);
+    ASSERT_TRUE(lease.End(12, 10.5, 10.3));
+    EXPECT_TRUE(lease.status().latched);
+    EXPECT_FALSE(lease.Accept(Walk(13, 10.5), 10.3));
+    ASSERT_TRUE(lease.Rearm(14, 10.5, 10.3));
+    EXPECT_TRUE(lease.status().latched);
+    ASSERT_TRUE(lease.Accept(Idle(15, 10.5), 10.3));
+    EXPECT_TRUE(lease.Install(10.3));
+    EXPECT_FALSE(lease.status().latched);
+}
+TEST(PlannerLease, PoseSuspendsPlannerLease) {
+    PlannerLease lease; Begin(lease); lease.EnterPose(); lease.Tick(20);
+    EXPECT_FALSE(lease.status().latched);
+    EXPECT_FALSE(lease.Accept(Idle(12, 20.2), 20));
+    EXPECT_FALSE(lease.Rearm(12, 20.2, 20));
+}
+TEST(PlannerLease, HandbackNeedsNewBegin) {
+    PlannerLease lease; Begin(lease); lease.EnterPose(); lease.Handback(20);
+    EXPECT_EQ(lease.status().high_water, 11);
+    EXPECT_FALSE(lease.Accept(Walk(12, 20.2), 20));
+    EXPECT_TRUE(lease.Rearm(12, 20.2, 20));
+}
+TEST(PlannerLease, LegacyPlannerRejected) {
+    PlannerLease lease; Begin(lease);
+    EXPECT_FALSE(lease.Accept(GuardedPlannerPacket{}, 10));
+}
+TEST(PlannerLease, RejectsInvalidIntentAndNonfiniteWithFastMath) {
+    PlannerLease lease; Begin(lease);
+    auto p = Walk(12, 10.2);
+    p.speed = std::numeric_limits<float>::quiet_NaN();
+    EXPECT_FALSE(lease.Accept(p, 10));
+    p = Walk(12, std::numeric_limits<double>::infinity());
+    EXPECT_FALSE(lease.Accept(p, 10));
+    p = Walk(12, 10.2); p.movement = {1, 0, .001f};
+    EXPECT_FALSE(lease.Accept(p, 10));
+    p = Idle(12, 10.2); p.speed = .1f;
+    EXPECT_FALSE(lease.Accept(p, 10));
+    p = Walk(12, 10.2); p.speed = .201f;
+    EXPECT_FALSE(lease.Accept(p, 10));
+    p = Walk(12, 10.2); p.height = 0;
+    EXPECT_FALSE(lease.Accept(p, 10));
+    EXPECT_EQ(lease.status().high_water, 11);
+}
+TEST(PlannerLease, CapsFutureDeadlineAndBoundsRearmWindow) {
+    PlannerLease lease; Begin(lease);
+    ASSERT_TRUE(lease.Accept(Walk(12, 100), 10));
+    ASSERT_TRUE(lease.Install(10));
+    lease.Tick(10.251);
+    EXPECT_EQ(lease.status().mode, 0);
+    EXPECT_TRUE(lease.status().latched);
+    ASSERT_TRUE(lease.Rearm(13, 100, 20));
+    EXPECT_FALSE(lease.Accept(Idle(14, 100), 20.251));
+    EXPECT_TRUE(lease.status().latched);
+}

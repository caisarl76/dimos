+#include <gtest/gtest.h>
+#include "input_interface/zmq_manager.hpp"
+
+namespace {
+double Now() {
+    return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+template<class Predicate> bool Wait(Predicate predicate) {
+    const auto limit = Now() + 1;
+    while (Now() < limit) {
+        if (predicate()) return true;
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    return false;
+}
+template<class T> void Bytes(std::vector<char>& data, const T& value) {
+    const auto* ptr = reinterpret_cast<const char*>(&value);
+    data.insert(data.end(), ptr, ptr + sizeof(value));
+}
+void Send(zmq::socket_t& socket, const std::string& topic, nlohmann::json fields, std::vector<char> payload) {
+    const auto header = nlohmann::json{{"v",1},{"endian","le"},{"count",1},{"fields",fields}}.dump();
+    std::vector<char> packet(topic.begin(), topic.end());
+    packet.resize(topic.size() + 1280, 0);
+    std::memcpy(packet.data() + topic.size(), header.data(), header.size());
+    packet.insert(packet.end(), payload.begin(), payload.end());
+    socket.send(zmq::buffer(packet), zmq::send_flags::none);
+}
+nlohmann::json F(const char* name, const char* dtype, int count) {
+    return { {"name",name},{"dtype",dtype},{"shape",{count}} };
+}
+void Control(zmq::socket_t& socket, int action, int64_t sequence, double deadline) {
+    std::vector<char> payload;
+    Bytes(payload,uint8_t{0}); Bytes(payload,uint8_t{0}); Bytes(payload,uint8_t{1});
+    Bytes(payload,int32_t{action}); Bytes(payload,sequence); Bytes(payload,deadline);
+    Send(socket,"command",{F("start","u8",1),F("stop","u8",1),F("planner","u8",1),
+        F("navigation_control","i32",1),F("planner_sequence","i64",1),F("planner_deadline","f64",1)},payload);
+}
+void Planner(zmq::socket_t& socket, int mode, int64_t sequence, double deadline, bool trailing = false) {
+    std::vector<char> payload;
+    Bytes(payload,int32_t{mode});
+    Bytes(payload,std::array<float,3>{mode ? 1.f : 0.f,0,0});
+    Bytes(payload,std::array<float,3>{1,0,0});
+    Bytes(payload,mode ? .2f : 0.f); Bytes(payload,-1.f);
+    Bytes(payload,sequence); Bytes(payload,deadline);
+    if (trailing) Bytes(payload,uint8_t{1});
+    Send(socket,"planner",{F("mode","i32",1),F("movement","f32",3),F("facing","f32",3),
+        F("speed","f32",1),F("height","f32",1),F("planner_sequence","i64",1),
+        F("planner_deadline","f64",1)},payload);
+}
+}
+
